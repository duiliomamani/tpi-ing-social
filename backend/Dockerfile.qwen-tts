FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 libgomp1 sox libsox-fmt-base \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-qwen-tts.txt ./requirements-qwen-tts.txt

# Use CPU wheels so the same image runs under Docker Desktop and Linux Docker.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch torchaudio \
    && pip install -r requirements-qwen-tts.txt

COPY app ./app

EXPOSE 8001
CMD ["uvicorn", "app.qwen_tts_service:app", "--host", "0.0.0.0", "--port", "8001"]
